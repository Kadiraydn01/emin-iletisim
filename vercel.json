{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm ci",
  "framework": null,
  "regions": ["fra1"],
  "functions": {"api/index.mjs": {"maxDuration": 30, "includeFiles": "{public/**,site.config.json,src/**}"}},
  "rewrites": [{"source": "/(.*)", "destination": "/api/index?__path=/$1"}],
  "headers": [{"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
}
